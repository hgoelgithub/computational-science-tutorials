   "source": [
    "from rdkit import Chem\n",
    "from rdkit.Chem import AllChem\n",
    "\n",
    "mol = Chem.MolFromSmiles(\"CCO\")\n",
    "fp = AllChem.GetMorganFingerprintAsBitVect(mol, 2, nBits=1024)\n",
    "print(fp)"
   ]
  }
