   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "data = pd.DataFrame({\n",
    "    \"MW\":[100,200,300],\n",
    "    \"LogP\":[1,3,5]\n",
    "})\n",
    "\n",
    "plt.scatter(data[\"MW\"], data[\"LogP\"])\n",
    "plt.xlabel(\"MW\")\n",
    "plt.ylabel(\"LogP\")\n",
    "plt.show()"
   ]
